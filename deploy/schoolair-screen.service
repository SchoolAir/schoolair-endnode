[Unit]
Description=SchoolAir: status display (Waveshare 1.47" Touch LCD)
# PROTOTYPE — one physical unit, not a fleet feature yet. Deliberately NOT in
# schoolair_setup.sh's install/enable list: installing this unconditionally
# would land on every device on the next OTA, including the ones that don't
# have this display wired up at all. Deploy and enable by hand for now; wire
# it into schoolair_setup.sh (and decide whether it's indoor-only, like the
# LED) once this is more than a one-off.
#
# No pigpiod dependency — unlike schoolair-led.service, this uses gpiozero /
# RPi.GPIO / spidev / smbus2 directly, not pigpio.
ConditionPathExists=/etc/schoolair-unit-type

[Service]
Type=simple
# admin, not root: matches schoolair.service's own default, on the assumption
# that stock Raspberry Pi OS's gpio/i2c/spi group membership for the default
# user is enough for gpiozero/RPi.GPIO/spidev/smbus2 (unlike pigpio, which is
# why schoolair-led.service specifically needs root). Not yet verified live —
# if this unit fails to start with a permissions error, that's the first
# thing to check; switch to User=root if so.
User=admin
WorkingDirectory=/home/admin/schoolair
ExecStart=/usr/bin/python3 -u /home/admin/schoolair/screen_status.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
