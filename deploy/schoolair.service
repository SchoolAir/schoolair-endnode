[Unit]
Description=SchoolAir sensor ingest
After=network-online.target sen6x.service
Wants=network-online.target sen6x.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/schoolair
ExecStart=/home/admin/schoolair/.venv/bin/python -u /home/admin/schoolair/main.py
Restart=on-failure
RestartSec=10
# 78 = device_identity.EXIT_MISMATCH: this card was registered on a different
# Pi. Restarting can't fix that — re-registering (wizard, AP mode) does.
RestartPreventExitStatus=78
# /run/schoolair (tmpfs, owned by admin) holds device_identity.MISMATCH_FILE for
# netwatch.sh. Preserved across stop/restart so the flag outlives the exit above;
# a reboot still wipes it.
RuntimeDirectory=schoolair
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
