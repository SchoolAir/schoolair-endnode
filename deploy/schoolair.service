[Unit]
Description=SchoolAir sensor ingest
# Readings don't need the network: latest.json (the wilting flower) is written
# from the first read, and uploads queue in SQLite until Wi-Fi appears, so this
# starts as soon as the sensor is initialised, not after network-online.target.
# Found on 2026-10-02: on a battery, in a building with no known Wi-Fi, the
# flower stood still for minutes after each power-up while this unit waited
# for a network that never came. The boot connectivity ping and the NTP
# correction already cope with starting offline.
After=network.target sen6x.service
Wants=sen6x.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/schoolair
ExecStart=/home/admin/schoolair/.venv/bin/python -u /home/admin/schoolair/main.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# /run/schoolair (tmpfs, owned by admin) holds device_identity.MISMATCH_FILE for
# the wizard and netwatch.sh, and latest.json, the current reading published
# for other local services such as the wilting flower (see state.py).
# Preserved across stop/restart; a reboot wipes it.
RuntimeDirectory=schoolair
RuntimeDirectoryPreserve=yes
Environment=LATEST_READING_FILE=/run/schoolair/latest.json

[Install]
WantedBy=multi-user.target
